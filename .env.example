# --- Google APIs (Google Business Profile / Maps) ---
GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_BUSINESS_ACCOUNT_ID=
TARGET_SERVICE=sliding glass door repair

# --- WhatsApp Cloud API (Meta for Developers) ---
# Obtén estos valores en https://developers.facebook.com/apps -> tu app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=handyglass-verify-token
WHATSAPP_API_VERSION=v20.0
WHATSAPP_APP_SECRET=

# --- Datos del negocio: Handy Glass & Door LLC / HGD Sliding Door Repair ---
BUSINESS_NAME=Handy Glass & Door LLC (HGD Sliding Door Repair)
BUSINESS_WEBSITE=https://hgdslidingdoor-repair.com
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_HOURS=Lunes a Sábado, 8:00 AM - 6:00 PM / Mon-Sat, 8:00 AM - 6:00 PM
SERVICE_AREA=South Florida y áreas cercanas

# --- Persistencia ---
APPOINTMENTS_DB_PATH=data/appointments.db

# --- Panel de administración (endpoint /admin/appointments) ---
ADMIN_TOKEN=

# --- Servidor ---
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
